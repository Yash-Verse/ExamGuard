# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/examguard
# Used only by `npm test`. Must be a different database from MONGO_URI.
TEST_MONGO_URI=mongodb://127.0.0.1:27017/examguard_test
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
# Comma-separated explicit origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=10
# Only for `npm run create-admin` (remove from .env afterwards)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
